{
  "name": "@vickbk/ci-tools",
  "version": "0.1.0",
  "description": "Programmatic CI workflow utilities for documentation, releases, GitHub Actions, and Vitest reporting.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vickbk/ci-tools.git"
  },
  "author": "Vick Bake <vickbake8@gmail.com>",
  "keywords": [
    "ci",
    "github-actions",
    "release-automation",
    "vitest",
    "coverage",
    "readme-validation"
  ],
  "bugs": {
    "url": "https://github.com/vickbk/ci-tools/issues"
  },
  "homepage": "https://github.com/vickbk/ci-tools#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.mts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs"
    },
    "./docs": {
      "types": "./dist/docs.d.mts",
      "import": "./dist/docs.mjs",
      "require": "./dist/docs.cjs"
    },
    "./github": {
      "types": "./dist/github.d.mts",
      "import": "./dist/github.mjs",
      "require": "./dist/github.cjs"
    },
    "./releases": {
      "types": "./dist/releases.d.mts",
      "import": "./dist/releases.mjs",
      "require": "./dist/releases.cjs"
    },
    "./vitest": {
      "types": "./dist/vitest.d.mts",
      "import": "./dist/vitest.mjs",
      "require": "./dist/vitest.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "lint": "eslint",
    "prepublishOnly": "pnpm typecheck && pnpm build",
    "release-note": "tsx ./src/bin/extract-release-note.ts",
    "release-tag": "tsx ./src/bin/extract-version-tag.ts",
    "test-comment": "tsx ./src/bin/post-vitest-coverage.ts",
    "coverage-summary": "tsx ./src/bin/coverage-summary.ts",
    "readme-check": "tsx ./src/bin/documentation/readme-check",
    "readme-comment": "tsx ./src/bin/documentation/post-readme-comment"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
